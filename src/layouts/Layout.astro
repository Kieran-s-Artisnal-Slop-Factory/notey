---
import '../styles/theme.css';
import '../styles/global.css';
import { href } from '../lib/paths';

interface Props {
  title: string;
}

const { title } = Astro.props;
// Base-aware paths for the inline scripts / static links below (works whether
// the app is served at the root or under a sub-path like GitHub Pages).
const swPath = href('/sw.js');
---

<!doctype html>
<html lang="en" data-sw-path={swPath}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="notey — notes on paper, in your browser" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="stylesheet" href={href('/fonts/fonts.css')} />
    <title>{title} · notey</title>
    <script is:inline>
      // The look, applied before first paint so there is no flash of the
      // wrong paper. Three plain strings rather than the preferences blob,
      // so this cannot throw on a half-written value; src/lib/prefs.ts
      // mirrors them on every save and applies the same three attributes
      // when a choice changes mid-session.
      (() => {
        // Kept in step with PAPERS in src/lib/prefs.ts: a paper, and
        // whether native controls should render light or dark on it.
        const SCHEMES = {
          light: 'light',
          dark: 'dark',
          plain: 'light',
          legal: 'light',
          greenbar: 'light',
          blueprint: 'light',
          'blueprint-inverse': 'dark',
          black: 'dark',
        };
        const root = document.documentElement;
        let page = null;
        let desk = null;
        let grain = null;
        let accent = null;
        let rule = null;
        try {
          page = localStorage.getItem('notey-page');
          desk = localStorage.getItem('notey-desk');
          grain = localStorage.getItem('notey-grain');
          accent = localStorage.getItem('notey-accent');
          rule = localStorage.getItem('notey-rule');
        } catch {}
        const paper =
          page && SCHEMES[page]
            ? page
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        const scheme = SCHEMES[paper];
        root.dataset.page = paper;
        root.dataset.desk =
          desk && desk !== 'system' ? desk : scheme === 'dark' ? 'plain-dark' : 'plain-light';
        root.dataset.grain = grain || 'fine';
        root.dataset.accent = accent || 'ink';
        root.dataset.rule = rule === 'off' ? 'off' : 'on';
        root.style.colorScheme = scheme;
      })();
    </script>
  </head>
  <body>
    <script>
      // Test hook: the chunk is fetched ONLY when the test-mode flag is set
      // on this profile, so a real user never downloads it. See
      // src/lib/testMode.ts.
      import { installTestHookIfEnabled } from '../lib/testMode';
      installTestHookIfEnabled();
    </script>
    <main class="page">
      <slot />
    </main>
    {
      import.meta.env.PROD ? (
        <script is:inline>
          // Tauri serves the app from its own protocol and needs no service
          // worker; a SW there would only cache a moving target.
          if ('serviceWorker' in navigator && !('__TAURI_INTERNALS__' in window)) {
            window.addEventListener('load', () => {
              // The base-aware SW path is on <html data-sw-path>; registering
              // it there also sets the worker's scope to the base.
              navigator.serviceWorker
                .register(document.documentElement.dataset.swPath)
                .catch(() => {});
            });
          }
        </script>
      ) : (
        <script is:inline>
          // Dev: the service worker must NOT run — it caches Vite's module
          // URLs and serves stale code after edits (blank pages). Unregister
          // any leftover registration and drop only OUR caches (this page may
          // share an origin with other apps under a path-multiplexing host).
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then((regs) => {
              for (const reg of regs) reg.unregister();
            });
            if (window.caches) {
              caches.keys().then((keys) => keys.filter((k) => k.startsWith('notey-cache-')).forEach((k) => caches.delete(k)));
            }
          }
        </script>
      )
    }
  </body>
</html>

<style>
  /* There is no chrome above the page any more; `main` simply fills the
     desk. The navbar token stays because ported components read it. */
  .page {
    min-height: 100dvh;
  }
</style>
